#:kivy 1.0
#:import utils kivy.utils

<SettingsScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 40
        spacing: 18

        Label:
            text: "[b][size=40]Settings[/size][/b]"
            markup: True
            size_hint: (1, None)
            height: '60dp'

        Label:
            text: "Username"
            font_size: '20sp'
            halign: 'left'
            text_size: self.size
            size_hint: (1, None)
            height: '25dp'
        TextInput:
            id: username_input
            hint_text: "Username"
            multiline: False
            size_hint: (1, None)
            height: '50dp'

        Label:
            text: "Email"
            font_size: '20sp'
            halign: 'left'
            text_size: self.size
            size_hint: (1, None)
            height: '25dp'
        TextInput:
            id: email_input
            hint_text: "Email"
            multiline: False
            size_hint: (1, None)
            height: '50dp'

        BoxLayout:
            size_hint: (1, None)
            height: '50dp'
            Label:
                text: "Notifications"
                font_size: '20sp'
                valign: 'middle'
                text_size: self.size
            Switch:
                id: notifications_switch
                active: True
                size_hint: (None, 1)
                width: '80dp'

        Label:
            text: root.status_text
            color: utils.get_color_from_hex("#1f7a3d")
            size_hint: (1, None)
            height: '24dp'

        Widget:   # spacer pushes the buttons to the bottom

        AppButton:
            text: "Save Changes"
            on_release: root.save_settings()

        Button:
            text: "Delete User Data"
            size_hint: (1, None)
            height: '40dp'
            font_size: '20sp'
            bold: True
            color: (1, 1, 1, 1)
            background_normal: ''
            background_color: (0, 0, 0, 0)
            on_release: root.delete_user_data()
            canvas.before:
                Color:
                    rgba: utils.get_color_from_hex("#e74c3c")
                RoundedRectangle:
                    size: self.size
                    pos: self.pos
                    radius: [15]

        Label:
            text: "CipherHunt v1.0"
            font_size: '14sp'
            color: utils.get_color_from_hex("#9e9e9e")
            size_hint: (1, None)
            height: '28dp'